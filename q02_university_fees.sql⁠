-- (e) View
CREATE OR REPLACE VIEW v_fee_balances AS
SELECT 
    s.student_number,
    s.full_name,
    fn_fee_balance(s.student_id) AS outstanding_balance
FROM students s
WHERE fn_fee_balance(s.student_id) > 0;

-- (f) Index
-- Justification: Putting student_id first narrows down rows via equality before range-scanning paid_on.
CREATE INDEX idx_payments_student_date ON payments (student_id, paid_on);

