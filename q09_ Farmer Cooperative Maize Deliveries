-- (e) View
CREATE OR REPLACE VIEW v_farmer_amount_due AS
SELECT 
    f.farmer_number,
    f.full_name,
    COALESCE(SUM(d.total_value), 0.00) AS total_unpaid_due
FROM farmers f
LEFT JOIN deliveries d ON f.farmer_id = d.farmer_id AND d.is_paid = FALSE
GROUP BY f.farmer_id, f.farmer_number, f.full_name;

-- (f) Index
-- Justification: Composite index on (farmer_id, delivered_on) filters directly to a single farmer and scans their deliveries chronologically across the date range.
CREATE INDEX idx_deliveries_farmer_date ON deliveries (farmer_id, delivered_on);

