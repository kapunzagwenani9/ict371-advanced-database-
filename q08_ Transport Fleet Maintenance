-- (e) View
CREATE OR REPLACE VIEW v_service_due AS
SELECT 
    registration,
    (current_odometer - last_service_odometer) AS km_since_service
FROM vehicles
WHERE fn_service_due(vehicle_id) = TRUE;

-- (f) Index
-- Justification: Placing vehicle_id first allows an equality seek for the specific vehicle, followed by an ordered index range scan on trip_on.
CREATE INDEX idx_trips_vehicle_date ON trips (vehicle_id, trip_on);

EXPLAIN ANALYZE
SELECT * FROM trips
WHERE vehicle_id = 2 AND trip_on BETWEEN CURRENT_DATE - 7 AND CURRENT_DATE;

-- (g) Scheduled job
CREATE OR REPLACE PROCEDURE pr_refresh_service_alerts()
LANGUAGE plpgsql AS $$
BEGIN
    DELETE FROM service_alerts
    WHERE vehicle_id IN (
        SELECT vehicle_id FROM vehicles WHERE fn_service_due(vehicle_id) = FALSE
    );

    INSERT INTO service_alerts (vehicle_id, km_since_service, flagged_on)
    SELECT 
        vehicle_id,
        current_odometer - last_service_odometer,
        CURRENT_DATE
    FROM vehicles
    WHERE fn_service_due(vehicle_id) = TRUE
    ON CONFLICT (vehicle_id) DO UPDATE SET
        km_since_service = EXCLUDED.km_since_service,
        flagged_on = EXCLUDED.flagged_on;
END;
$$;

SELECT cron.schedule('refresh_service_alerts', '0 6 * * 1', $$CALL pr_refresh_service_alerts()$$);
