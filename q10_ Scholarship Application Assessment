-- (b) Function
CREATE OR REPLACE FUNCTION fn_scholarship_eligible(p_age INT, p_income NUMERIC, p_mark NUMERIC)
RETURNS BOOLEAN AS $$
BEGIN
    IF p_age IS NULL OR p_income IS NULL OR p_mark IS NULL THEN
        RAISE EXCEPTION 'Eligibility inputs cannot be NULL';
    END IF;

    IF p_age <= 0 THEN
        RAISE EXCEPTION 'Age must be positive';
    END IF;

    IF p_income < 0 THEN
        RAISE EXCEPTION 'Monthly income cannot be negative';
    END IF;

    IF p_mark < 0 OR p_mark > 100 THEN
        RAISE EXCEPTION 'Average mark must be between 0 and 100';
    END IF;

    RETURN (p_age BETWEEN 18 AND 25)
       AND (p_income <= 3000.00)
       AND (p_mark >= 70.00);
END;
$$ LANGUAGE plpgsql;

-- (c) Procedure
CREATE OR REPLACE PROCEDURE pr_assess_application(p_application_id INT)
LANGUAGE plpgsql AS $$
DECLARE
    v_age INT;
    v_income NUMERIC(10, 2);
    v_mark NUMERIC(5, 2);
    v_status VARCHAR(15);
    v_new_status VARCHAR(15);
BEGIN
    SELECT age_at_application, monthly_income, average_mark, status
    INTO v_age, v_income, v_mark, v_status
    FROM applications
    WHERE application_id = p_application_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Application ID % does not exist', p_application_id;
    END IF;

    IF v_status <> 'PENDING' THEN
        RAISE EXCEPTION 'Application ID % has already been assessed (status: %)', p_application_id, v_status;
    END IF;

    IF fn_scholarship_eligible(v_age, v_income, v_mark) THEN
        v_new_status := 'APPROVED';
    ELSE
        v_new_status := 'REJECTED';
    END IF;

    UPDATE applications
    SET status = v_new_status
    WHERE application_id = p_application_id;
END;
$$;

-- (d) Trigger
CREATE OR REPLACE FUNCTION trg_fn_decision_audit()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.status IS DISTINCT FROM OLD.status THEN
        INSERT INTO decision_audit (application_id, old_status, new_status, changed_at)
        VALUES (NEW.application_id, OLD.status, NEW.status, CURRENT_TIMESTAMP);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_applications_decision_audit
AFTER UPDATE ON applications
FOR EACH ROW
EXECUTE FUNCTION trg_fn_decision_audit();

-- (e) View
CREATE OR REPLACE VIEW v_approved_applicants AS
SELECT 
    s.student_number,
    s.full_name,
    a.average_mark,
    a.status
FROM applications a
JOIN students s ON a.student_id = s.student_id
WHERE a.status = 'APPROVED';

-- (f) Index
-- Justification: Filtering by status equality first partitions the index by state (e.g., PENDING or APPROVED), allowing a fast range scan over submitted_on.
CREATE INDEX idx_applications_status_date ON applications (status, submitted_on);

EXPLAIN ANALYZE
SELECT * FROM applications
WHERE status = 'PENDING' AND submitted_on BETWEEN CURRENT_DATE - 7 AND CURRENT_DATE;

-- (g) Scheduled job
CREATE OR REPLACE PROCEDURE pr_assess_pending()
LANGUAGE plpgsql AS $$
DECLARE
    rec RECORD;
BEGIN
    FOR rec IN SELECT application_id FROM applications WHERE status = 'PENDING' ORDER BY application_id LOOP
        CALL pr_assess_application(rec.application_id);
    END LOOP;
END;
$$;

SELECT cron.schedule('weekly_assess_pending', '0 8 * * 1', $$CALL pr_assess_pending()$$);
