-- (b) Function
CREATE OR REPLACE FUNCTION fn_net_pay(p_employee_id INT)
RETURNS NUMERIC AS $$
DECLARE
    v_basic NUMERIC(12, 2);
    v_allow NUMERIC(12, 2);
    v_deduct NUMERIC(12, 2);
    v_net NUMERIC(12, 2);
BEGIN
    SELECT basic_salary, allowance, deduction INTO v_basic, v_allow, v_deduct
    FROM employees
    WHERE employee_id = p_employee_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown employee ID: %', p_employee_id;
    END IF;

    v_net := (v_basic + v_allow) - v_deduct;

    IF v_net < 0 THEN
        RAISE EXCEPTION 'Computed net pay cannot be negative for employee %', p_employee_id;
    END IF;

    RETURN v_net;
END;
$$ LANGUAGE plpgsql;

-- (c) Procedure
CREATE OR REPLACE PROCEDURE pr_process_payroll(p_month DATE)
LANGUAGE plpgsql AS $$
DECLARE
    rec RECORD;
    v_gross NUMERIC(12, 2);
    v_net NUMERIC(12, 2);
BEGIN
    IF p_month IS NULL OR EXTRACT(DAY FROM p_month) <> 1 THEN
        RAISE EXCEPTION 'p_month must be the first day of a month';
    END IF;

    FOR rec IN SELECT employee_id, basic_salary, allowance FROM employees WHERE active = TRUE LOOP
        v_net := fn_net_pay(rec.employee_id);
        v_gross := rec.basic_salary + rec.allowance;

        INSERT INTO payroll (employee_id, pay_month, gross_pay, net_pay)
        VALUES (rec.employee_id, p_month, v_gross, v_net)
        ON CONFLICT (employee_id, pay_month) DO NOTHING;
    END LOOP;
END;
$$;

-- (d) Trigger
CREATE OR REPLACE FUNCTION trg_fn_salary_audit()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.basic_salary IS DISTINCT FROM OLD.basic_salary THEN
        INSERT INTO salary_audit (employee_id, old_salary, new_salary, changed_at)
        VALUES (NEW.employee_id, OLD.basic_salary, NEW.basic_salary, CURRENT_TIMESTAMP);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_employees_salary_audit
AFTER UPDATE ON employees
FOR EACH ROW
EXECUTE FUNCTION trg_fn_salary_audit();

-- (e) View
CREATE OR REPLACE VIEW v_payroll_report AS
SELECT 
    e.full_name,
    p.pay_month,
    p.gross_pay,
    p.net_pay
FROM payroll p
JOIN employees e ON p.employee_id = e.employee_id;

-- (f) Index
-- Justification: The existing unique constraint on (employee_id, pay_month) cannot efficiently serve queries filtering solely by pay_month because pay_month is the trailing column. A standalone index on pay_month resolves this.
CREATE INDEX idx_payroll_pay_month ON payroll (pay_month);

-- (g) Scheduled job
SELECT cron.schedule(
    'monthly_payroll_run',
    '0 2 1 * *',
    $$CALL pr_process_payroll((DATE_TRUNC('month', CURRENT_DATE) - INTERVAL '1 month')::DATE)$$
);

