-- (e) View
CREATE OR REPLACE VIEW v_overdue_bills AS
SELECT 
    c.full_name AS customer_name,
    b.due_on,
    (b.charge - b.amount_paid) AS outstanding_amount
FROM bills b
JOIN readings r ON b.reading_id = r.reading_id
JOIN customers c ON r.customer_id = c.customer_id
WHERE b.due_on < CURRENT_DATE
  AND b.amount_paid < b.charge;

-- (f) Index
-- Justification: A partial B-tree index on due_on where amount_paid < charge indexes only open bills, accelerating date-range scans for overdue accounts.
CREATE INDEX idx_bills_unpaid_due ON bills (due_on) WHERE amount_paid < charge;

EXPLAIN ANALYZE
SELECT * FROM bills
WHERE due_on < CURRENT_DATE AND amount_paid < charge;

-- (g) Scheduled job
CREATE OR REPLACE PROCEDURE pr_refresh_receivables()
LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO receivable_snapshot (snapshot_date, total_due)
    SELECT 
        CURRENT_DATE,
        COALESCE(SUM(charge - amount_paid), 0.00)
    FROM bills
    WHERE amount_paid < charge
    ON CONFLICT (snapshot_date) DO UPDATE SET
        total_due = EXCLUDED.total_due;
END;
$$;

SELECT cron.schedule('refresh_receivables', '30 0 * * *', $$CALL pr_refresh_receivables()$$);
