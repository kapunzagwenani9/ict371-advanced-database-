-- (b) Function
CREATE OR REPLACE FUNCTION fn_loan_fine(p_loan_id INT, p_as_of DATE)
RETURNS NUMERIC AS $$
DECLARE
    v_due_on DATE;
    v_returned_on DATE;
    v_effective_date DATE;
    v_overdue_days INT;
BEGIN
    SELECT due_on, returned_on INTO v_due_on, v_returned_on
    FROM loans
    WHERE loan_id = p_loan_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown loan ID: %', p_loan_id;
    END IF;

    IF v_returned_on IS NOT NULL THEN
        v_effective_date := LEAST(p_as_of, v_returned_on);
    ELSE
        v_effective_date := p_as_of;
    END IF;

    v_overdue_days := GREATEST(0, v_effective_date - v_due_on);
    RETURN (v_overdue_days * 2)::NUMERIC(10, 2);
END;
$$ LANGUAGE plpgsql;

-- (c) Procedure
CREATE OR REPLACE PROCEDURE pr_return_loan(p_loan_id INT, p_returned_on DATE)
LANGUAGE plpgsql AS $$
DECLARE
    v_borrowed_on DATE;
    v_returned_on DATE;
    v_fine NUMERIC(10, 2);
BEGIN
    SELECT borrowed_on, returned_on INTO v_borrowed_on, v_returned_on
    FROM loans
    WHERE loan_id = p_loan_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Loan ID % does not exist', p_loan_id;
    END IF;

    IF v_returned_on IS NOT NULL THEN
        RAISE EXCEPTION 'Loan ID % is already returned', p_loan_id;
    END IF;

    IF p_returned_on IS NULL OR p_returned_on < v_borrowed_on THEN
        RAISE EXCEPTION 'Return date cannot be null or before borrowed date (%)', v_borrowed_on;
    END IF;

    v_fine := fn_loan_fine(p_loan_id, p_returned_on);

    UPDATE loans
    SET returned_on = p_returned_on,
        fine_amount = v_fine
    WHERE loan_id = p_loan_id;
END;
$$;

-- (d) Trigger
CREATE OR REPLACE FUNCTION trg_fn_loan_audit()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.returned_on IS DISTINCT FROM OLD.returned_on THEN
        INSERT INTO loan_audit (loan_id, old_returned_on, new_returned_on, changed_at)
        VALUES (NEW.loan_id, OLD.returned_on, NEW.returned_on, CURRENT_TIMESTAMP);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_loans_return_audit
AFTER UPDATE ON loans
FOR EACH ROW
EXECUTE FUNCTION trg_fn_loan_audit();

-- (e) View
CREATE OR REPLACE VIEW v_overdue_loans AS
SELECT 
    b.title AS book_title,
    l.borrower_name,
    l.due_on,
    fn_loan_fine(l.loan_id, CURRENT_DATE) AS fine_today
FROM loans l
JOIN books b ON l.book_id = b.book_id
WHERE l.returned_on IS NULL 
  AND l.due_on < CURRENT_DATE;

